   "metadata": {},
   "outputs": [],
   "source": [
    "data = {\n",
    "    'a':[1,2,3,4,5],\n",
    "    'b':[6,7,8,9,10],\n",
    "    'c':['x','y','z','q','w']\n",
    "}\n",
    "df = pd.DataFrame(data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "79238510",
   "metadata": {},
   "outputs": [
