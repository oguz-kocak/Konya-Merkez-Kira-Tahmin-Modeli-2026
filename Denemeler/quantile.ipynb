     "text": [
      "a    3.0\n",
      "b    8.0\n",
      "Name: 0.5, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "try:\n",
    "    print(df.quantile(0.5,numeric_only=True))\n",
    "except Exception as e:\n",
    "    print(e)"
   ]
  },
